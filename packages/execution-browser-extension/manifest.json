{
	"manifest_version": 3,
	"name": "ProFlow Execution Browser",
	"version": "0.1.55",
	"permissions": [
		"tabs",
		"alarms",
		"storage",
		"notifications"
	],
	"host_permissions": [
		"https://chatgpt.com/*",
		"http://127.0.0.1/*"
	],
	"background": {
		"service_worker": "dist/extension/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"https://chatgpt.com/g/*"
			],
			"js": [
				"dist/extension/content.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://chatgpt.com/gpts/editor",
				"https://chatgpt.com/gpts/editor/*"
			],
			"js": [
				"dist/extension/provisioning-content.js"
			],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_title": "Open ProFlow Tasks"
	},
	"options_page": "extension/options.html"
}
