{
	"name": "@tomflow/proflow-agent-runtime",
	"version": "0.1.3",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js",
		"./role-management-client": "./dist/src/role-management-client.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"yaml": "2.9.0",
		"zod": "4.1.12"
	},
	"devDependencies": {
		"@tomflow/proflow-deployment-conformance": "workspace:^",
		"@tomflow/proflow-module-contract": "workspace:^"
	},
	"description": "Agent-owned Role Registry, credential binding and Collaboration durable runtime.",
	"keywords": [
		"proflow",
		"proflow-module",
		"agent-runtime-collaboration"
	],
	"proflow": {
		"module": true,
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	}
}
