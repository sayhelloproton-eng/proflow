{
  "name": "@tomflow/proflow-task-orchestration",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./deployment/adapter": "./dist/deployment/adapter.js",
    "./deployment/descriptor": "./dist/deployment/descriptor.js"
  },
  "files": [
    "dist",
    "proflow.module.json",
    "conformance.json",
    "README.md",
    "self-install.mjs"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tomflow/proflow-module-contract": "workspace:^",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tomflow/proflow-deployment-conformance": "workspace:^",
    "@tomflow/proflow-task-migration-runner": "workspace:^",
    "@tomflow/proflow-task-store-sqlite": "workspace:^"
  },
  "description": "Owns the Task & Orchestration public contract, domain rules and application services.",
  "keywords": [
    "proflow",
    "proflow-module",
    "task-orchestration"
  ],
  "proflow": {
    "module": true,
    "installClass": "core",
    "installRequires": [
      "@tomflow/proflow-module-contract"
    ],
    "descriptor": "./dist/deployment/descriptor.js",
    "manifest": "./proflow.module.json"
  },
  "bin": {
    "proflow-task-orchestration": "./self-install.mjs"
  }
}
