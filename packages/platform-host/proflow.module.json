{
  "contract": "module",
  "contractVersion": "1.0.0",
  "moduleRef": "platform-host",
  "packageName": "@tomflow/proflow-platform-host",
  "moduleVersion": "0.1.5",
  "kind": "service",
  "templateVersion": "1.0.0",
  "platformCompatibility": ">=1.0.0 <2.0.0",
  "identity": {
    "domain": "platform-architecture",
