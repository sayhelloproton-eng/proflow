{
  "name": "@tomflow/proflow-platform-host",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./deployment/adapter": "./dist/deployment/adapter.js",
    "./deployment/descriptor": "./dist/deployment/descriptor.js",
    "./cli": "./dist/src/cli.js"
  },
  "bin": {
    "proflow-platform-host": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "proflow.module.json",
    "conformance.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --conditions=development --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tomflow/proflow-agent-runtime": "workspace:^",
    "@tomflow/proflow-execution-browser-extension": "workspace:^",
    "@tomflow/proflow-execution-contracts": "workspace:^",
    "@tomflow/proflow-task-migration-runner": "workspace:^",
    "@tomflow/proflow-task-orchestration": "workspace:^",
    "@tomflow/proflow-task-store-sqlite": "workspace:^",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tomflow/proflow-agent-gateway": "workspace:^",
    "@tomflow/proflow-deployment-conformance": "workspace:^",
    "@tomflow/proflow-execution-runtime": "workspace:^",
    "@tomflow/proflow-model-runtime": "workspace:^",
    "@tomflow/proflow-module-contract": "workspace:^"
  },
  "description": "Provides the ProFlow local application composition root that binds Task, Agent, Execution and Model owner transports.",
  "keywords": [
    "proflow",
    "proflow-module",
    "platform-architecture"
  ],
  "proflow": {
    "module": true,
    "installClass": "core",
    "descriptor": "./dist/deployment/descriptor.js",
    "installRequires": [
      "@tomflow/proflow-agent-runtime",
      "@tomflow/proflow-execution-browser-extension",
      "@tomflow/proflow-execution-contracts",
      "@tomflow/proflow-execution-runtime",
      "@tomflow/proflow-model-contracts",
      "@tomflow/proflow-task-migration-runner",
      "@tomflow/proflow-task-orchestration",
      "@tomflow/proflow-task-store-sqlite"
    ],
    "manifest": "./proflow.module.json"
  }
}
