{
	"name": "@tomflow/proflow-deployment-conformance",
	"version": "0.1.3",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./architecture": "./dist/src/architecture.js",
		"./cli": "./dist/src/cli.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"bin": {
		"proflow-architecture": "./dist/src/architecture-cli.js",
		"proflow-conformance": "./dist/src/cli.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"DOCS.md",
		"SETUP.md"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tomflow/proflow-module-contract": "workspace:^",
		"typescript": "7.0.2"
	},
	"devDependencies": {
		"@tomflow/proflow-module-template": "workspace:^"
	},
	"description": "Validates ProFlow module contract, package and behavior conformance.",
	"keywords": [
		"proflow",
		"proflow-module",
		"deployment-governance"
	],
	"proflow": {
		"module": true,
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	}
}
