{
	"name": "@tomflow/proflow-execution-local",
	"version": "0.1.15",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./direct-tools": "./dist/src/direct-tools.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"DOCS.md",
		"SETUP.md"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@colbymchenry/codegraph": "1.6.0",
		"@tomflow/proflow-execution-contracts": "workspace:^",
		"@tomflow/proflow-module-contract": "workspace:^",
		"repomix": "1.18.0"
	},
	"description": "Local Direct Tool executor with provider-isolated child processes.",
	"keywords": [
		"proflow",
		"proflow-module",
		"execution"
	],
	"proflow": {
		"module": true,
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	}
}
