		]
	},
	"effects": [],
	"documentation": [
		{
			"id": "overview",
			"path": "./README.md",
			"description": "Package-owned module overview"
		},
		{
			"id": "configuration",
			"path": "./CONFIGURATION.md",
			"description": "Module configuration fields, sources and materialization instructions"
		}
	]
