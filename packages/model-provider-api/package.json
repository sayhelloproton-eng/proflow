{
  "name": "@tomflow/proflow-model-provider-api",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./deployment/adapter": "./dist/deployment/adapter.js",
    "./deployment/descriptor": "./dist/deployment/descriptor.js"
  },
  "files": [
    "dist",
    "conformance.json",
    "README.md",
    "self-install.mjs"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tomflow/proflow-module-contract": "workspace:^"
  },
  "devDependencies": {
    "@tomflow/proflow-deployment-conformance": "workspace:^"
  },
  "description": "Governs and probes the configured OpenAI-compatible model provider API as an external resource.",
  "keywords": [
    "proflow",
    "proflow-module",
    "deployment-governance"
  ],
  "proflow": {
    "module": true,
    "installClass": "core",
    "descriptor": "./dist/deployment/descriptor.js"
  },
  "bin": {
    "proflow-model-provider-api": "./self-install.mjs"
  }
}
