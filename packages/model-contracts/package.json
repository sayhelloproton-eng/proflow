{
	"name": "@tomflow/proflow-model-contracts",
	"version": "0.1.1",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"self-install.mjs"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "4.1.12"
	},
	"description": "Typed public Model & Reasoning contracts and runtime validation for ProFlow inference.",
	"keywords": [
		"proflow",
		"proflow-module",
		"model-reasoning"
	],
	"proflow": {
		"module": true,
		"installClass": "core",
		"installRequires": [],
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	},
	"bin": {
		"proflow-model-contracts": "./self-install.mjs"
	}
}
