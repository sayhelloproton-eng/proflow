{
	"name": "@tomflow/proflow-execution-contracts",
	"version": "0.1.3",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "4.1.12"
	},
	"description": "Typed public Execution contracts and runtime validation for the ProFlow real-world effect plane.",
	"keywords": [
		"proflow",
		"proflow-module",
		"execution"
	],
	"proflow": {
		"module": true,
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	}
}
