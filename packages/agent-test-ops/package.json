{
	"name": "@tomflow/proflow-agent-test-ops",
	"version": "0.1.19",
	"description": "Versioned Test/Operations Custom GPT materialization package for the fixed Test-Ops role.",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"proflow-agent-test-ops": "./dist/src/cli.js"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"files": [
		"dist",
		"actions",
		"context",
		"memory",
		"knowledge",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"DOCS.md",
		"SETUP.md"
	],
	"proflowAgent": {
		"kind": "agent-package",
		"displayName": "部署 + 测试验收",
		"conversationStarters": [
			"检查当前测试节点与运行健康证据"
		],
		"instructions": "# 部署 + 测试验收\n模型侧只使用 Task / Node / Document / Peer / Tools 五类心智。通过 Task owner 工作流推进验收；test PASS 不等于 Task complete。仓库广域理解用 Repomix，结构关系用 CodeGraph，当前磁盘、test/build/typecheck/lint、logs/health/process/port 用 Local Dev。Local Tool 请求只提交 operation + input；不得提交 Execution identity，也不得把 Tool/Carrier/transport 问题伪装成业务 blocker。Tool 返回 UNKNOWN 时先观察真实文件、进程、端口和 Git 状态，禁止盲重放。WORKER_BIND 不推进工作；REOPEN 复用原 worker。不确定时保留证据并升级，不伪造 PASS。",
		"carrierProfiles": {
			"custom-gpt": {
				"recommendedModel": "gpt-5-6",
				"capabilities": {
					"webSearch": true,
					"imageGeneration": true,
					"codeInterpreter": true
				},
				"requirements": {
					"actions": "required",
					"fileBridge": "required",
					"codeInterpreter": "required",
					"webSearch": "required",
					"apps": "disabled"
				},
				"knowledgeBundle": "knowledge/custom-gpt-knowledge.zip",
				"actionSchema": "actions/custom-gpt.openapi.yaml"
			}
		}
	},
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@tomflow/proflow-deployment-conformance": "workspace:^",
		"yaml": "2.9.0"
	},
	"dependencies": {
		"@tomflow/proflow-agent-runtime": "workspace:^",
		"@tomflow/proflow-execution-browser-extension": "workspace:^",
		"@tomflow/proflow-module-contract": "workspace:^"
	},
	"keywords": [
		"proflow",
		"proflow-module",
		"agent-runtime-collaboration"
	],
	"proflow": {
		"module": true,
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	}
}
