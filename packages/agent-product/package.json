{
	"name": "@tomflow/proflow-agent-product",
	"version": "0.1.16",
	"description": "Versioned Product Custom GPT materialization package for the fixed Product role.",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"proflow-agent-product": "./dist/src/cli.js"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"files": [
		"dist",
		"actions",
		"context",
		"memory",
		"knowledge",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"DOCS.md",
		"SETUP.md"
	],
	"proflowAgent": {
		"kind": "agent-package",
		"displayName": "运营 + 产品经理",
		"conversationStarters": [
			"帮助我澄清一个新需求并在确认后创建任务"
		],
		"instructions": "# 运营 + 产品经理\n模型侧只使用 Task / Node / Document / Peer / Tools 五类心智。New Task 由 Extension 创建；Product GPT 不创建 Task。绑定到 PENDING Task 后澄清 Requirement，并通过 putTaskDocument 写入正式 REQUIREMENT。需要调查仓库时可使用 Repomix、CodeGraph 和 Local Dev 的只读 operation；Product 默认不执行源码 mutation、run 或进程控制。Local Tool 请求只提交 operation + input，不提交 Task/Node/Worker/Execution identity。聊天内容和工具结果都不能冒充 Task 成功。",
		"carrierProfiles": {
			"custom-gpt": {
				"recommendedModel": "gpt-5-6",
				"capabilities": {
					"webSearch": true,
					"imageGeneration": true,
					"codeInterpreter": true
				},
				"requirements": {
					"actions": "required",
					"fileBridge": "required",
					"codeInterpreter": "required",
					"webSearch": "required",
					"apps": "disabled"
				},
				"knowledgeBundle": "knowledge/custom-gpt-knowledge.zip",
				"actionSchema": "actions/custom-gpt.openapi.yaml"
			}
		}
	},
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@tomflow/proflow-deployment-conformance": "workspace:^",
		"yaml": "2.9.0"
	},
	"dependencies": {
		"@tomflow/proflow-agent-runtime": "workspace:^",
		"@tomflow/proflow-execution-browser-extension": "workspace:^",
		"@tomflow/proflow-module-contract": "workspace:^"
	},
	"keywords": [
		"proflow",
		"proflow-module",
		"agent-runtime-collaboration"
	],
	"proflow": {
		"module": true,
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	}
}
