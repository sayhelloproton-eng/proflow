{
	"name": "@tomflow/proflow-module-contract",
	"version": "0.1.7",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"DOCS.md",
		"SETUP.md"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "4.1.12"
	},
	"description": "Defines the canonical governance contract for ProFlow modules.",
	"keywords": [
		"proflow",
		"proflow-module",
		"deployment-governance"
	],
	"proflow": {
		"module": true,
		"manifest": "./proflow.module.json",
		"descriptor": "./dist/deployment/descriptor.js"
	}
}
