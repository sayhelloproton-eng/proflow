{
	"name": "@tomflow/proflow-task-store-sqlite",
	"version": "0.1.2",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./migrations": "./dist/src/migrations.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"self-install.mjs"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tomflow/proflow-module-contract": "workspace:^",
		"@tomflow/proflow-task-orchestration": "workspace:^"
	},
	"devDependencies": {
		"@tomflow/proflow-task-migration-runner": "workspace:^"
	},
	"description": "Provides the node:sqlite store and repository adapters for Task-owned structured facts.",
	"keywords": [
		"proflow",
		"proflow-module",
		"task-orchestration"
	],
	"proflow": {
		"module": true,
		"installClass": "core",
		"installRequires": [
			"@tomflow/proflow-module-contract",
			"@tomflow/proflow-task-orchestration"
		],
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	},
	"bin": {
		"proflow-task-store-sqlite": "./self-install.mjs"
	}
}
