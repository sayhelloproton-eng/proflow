{
	"name": "@tomflow/proflow-task-migration-runner",
	"version": "0.1.5",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./cli": "./dist/src/cli.js",
		"./deployment/adapter": "./dist/deployment/adapter.js",
		"./deployment/descriptor": "./dist/deployment/descriptor.js"
	},
	"bin": {
		"proflow-task-migrate": "./dist/src/cli.js"
	},
	"files": [
		"dist",
		"proflow.module.json",
		"conformance.json",
		"README.md",
		"DOCS.md",
		"SETUP.md"
	],
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tomflow/proflow-module-contract": "workspace:^",
		"@tomflow/proflow-task-store-sqlite": "workspace:^"
	},
	"description": "Deterministically discovers, applies and verifies Task Store SQLite schema migrations.",
	"keywords": [
		"proflow",
		"proflow-module",
		"task-orchestration"
	],
	"proflow": {
		"module": true,
		"descriptor": "./dist/deployment/descriptor.js",
		"manifest": "./proflow.module.json"
	}
}
