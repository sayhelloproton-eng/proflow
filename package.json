{
	"name": "proflow",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": "24.19.0"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"build": "node scripts/build-packages.mjs",
		"test": "pnpm build && node --test 'packages/*/tests/**/*.test.ts'",
		"architecture": "node packages/deployment-conformance/src/architecture-cli.ts && node scripts/deployment-graph-check.mjs",
		"publishability": "node scripts/publishability.mjs",
		"check": "pnpm test-governance && pnpm surface-governance && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm architecture && pnpm publishability",
		"test-governance": "node scripts/test-governance.mjs --check",
		"test-governance:write": "node scripts/test-governance.mjs --write",
		"surface-governance": "node scripts/surface-governance.mjs --check",
		"surface-governance:write": "node scripts/surface-governance.mjs --write",
		"release:status": "pnpm change status",
		"release:version:dry-run": "pnpm version -r --dry-run",
		"release:version": "pnpm version -r && node scripts/release-sync-versions.mjs --write",
		"release:sync": "node scripts/release-sync-versions.mjs --write",
		"release:sync:check": "node scripts/release-sync-versions.mjs --check",
		"release:publish:dry-run": "pnpm release:sync:check && pnpm -r publish --dry-run --no-git-checks",
		"release:publish": "pnpm release:sync:check && pnpm -r publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/node": "24.10.1",
		"esbuild": "0.28.1",
		"typescript": "7.0.2"
	}
}
