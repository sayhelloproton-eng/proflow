{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"rootDir": ".",
		"rewriteRelativeImportExtensions": true,
		"paths": {
			"@tomflow/proflow-model-contracts": [
				"./packages/model-contracts/src/index.ts"
			],
			"@tomflow/proflow-model-runtime": [
				"./packages/model-runtime/src/index.ts"
			],
			"@tomflow/proflow-module-contract": [
				"./packages/module-contract/src/index.ts"
			],
			"@tomflow/proflow-task-orchestration": [
				"./packages/task-orchestration/src/index.ts"
			],
			"@tomflow/proflow-task-store-sqlite": [
				"./packages/task-store-sqlite/src/index.ts"
			],
			"@tomflow/proflow-task-store-sqlite/migrations": [
				"./packages/task-store-sqlite/src/migrations.ts"
			]
		}
	},
	"include": ["packages/*/src/**/*.ts", "packages/*/deployment/**/*.ts"],
	"exclude": ["packages/*/tests/**"]
}
