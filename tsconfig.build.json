{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"rootDir": ".",
		"rewriteRelativeImportExtensions": true,
		"paths": {
			"@tomflow/proflow-agent-controller-dev": [
				"./packages/agent-controller-dev/src/index.ts"
			],
			"@tomflow/proflow-agent-gateway": [
				"./packages/agent-gateway/src/index.ts"
			],
			"@tomflow/proflow-agent-product": [
				"./packages/agent-product/src/index.ts"
			],
			"@tomflow/proflow-agent-product/deployment/adapter": [
				"./packages/agent-product/deployment/adapter.ts"
			],
			"@tomflow/proflow-agent-runtime": [
				"./packages/agent-runtime/src/index.ts"
			],
			"@tomflow/proflow-agent-test-ops": [
				"./packages/agent-test-ops/src/index.ts"
			],
			"@tomflow/proflow-execution-contracts": [
				"./packages/execution-contracts/src/index.ts"
			],
			"@tomflow/proflow-execution-local": [
				"./packages/execution-local/src/index.ts"
			],
			"@tomflow/proflow-execution-runtime": [
				"./packages/execution-runtime/src/index.ts"
			],
			"@tomflow/proflow-model-contracts": [
				"./packages/model-contracts/src/index.ts"
			],
			"@tomflow/proflow-model-runtime": [
				"./packages/model-runtime/src/index.ts"
			],
			"@tomflow/proflow-module-contract": [
				"./packages/module-contract/src/index.ts"
			],
			"@tomflow/proflow-task-orchestration": [
				"./packages/task-orchestration/src/index.ts"
			],
			"@tomflow/proflow-task-store-sqlite": [
				"./packages/task-store-sqlite/src/index.ts"
			],
			"@tomflow/proflow-task-store-sqlite/migrations": [
				"./packages/task-store-sqlite/src/migrations.ts"
			]
		}
	},
	"include": ["packages/*/src/**/*.ts", "packages/*/deployment/**/*.ts"],
	"exclude": ["packages/*/tests/**"]
}
